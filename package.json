{
  "name": "hpt-rag-local",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.5.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "vault:build": "pnpm --filter @hpt/server vault:build",
    "check:public": "node scripts/check-public-safe.mjs",
    "hpt": "pnpm --filter @hpt/server hpt",
    "lint": "oxlint",
    "dev:desktop": "pnpm --filter @hpt/desktop dev",
    "shots": "pnpm --filter @hpt/desktop shots",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test"
  },
  "devDependencies": {
    "oxlint": "^1.95.0"
  }
}
